{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    }
  },
  "autoupdate": false,
  "theme": "tokyonight",
  "instructions": ["~/.claude/rules/*.md"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "./x.sh nix-eval *": "allow",
      "./x.sh nix-update *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "bash -n *": "allow",
      "bash *": "allow",
      "cat *": "allow",
      "chmod *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "expr *": "allow",
      "false": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh repo view *": "allow",
      "gh search issues *": "allow",
      "gh search prs *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-tree *": "allow",
      "git show *": "allow",
      "go build *": "allow",
      "go doc *": "allow",
      "go mod *": "allow",
      "go run *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "gofumpt *": "allow",
      "golangci-lint run *": "allow",
      "grep *": "allow",
      "groups *": "allow",
      "head *": "allow",
      "id *": "allow",
      "jj --version": "allow",
      "jj bookmark create *": "allow",
      "jj commit *": "allow",
      "jj describe *": "allow",
      "jj diff *": "allow",
      "jj git fetch": "allow",
      "jj help *": "allow",
      "jj log *": "allow",
      "jj new *": "allow",
      "jj show *": "allow",
      "jj split *": "allow",
      "jj st *": "allow",
      "jj status *": "allow",
      "jj": "allow",
      "git-branch-current *": "allow",
      "git-branch-default *": "allow",
      "git-branch-next *": "allow",
      "git-branch-previous *": "allow",
      "git-branch-stacked *": "allow",
      "jj-bookmark-current *": "allow",
      "jj-bookmark-default *": "allow",
      "jj-bookmark-previous *": "allow",
      "jj-bookmark-stacked *": "allow",
      "jq *": "allow",
      "less *": "allow",
      "ln *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "mkdir *": "allow",
      "more *": "allow",
      "mv *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "read *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "seq *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "type *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs ls *": "allow",
      "zsh *": "allow"
    },
    "external_directory": {
      "~/.claude/**": "allow"
    }
  }
}
