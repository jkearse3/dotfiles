{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "autoupdate": false,
  "instructions": ["~/.config/opencode/rules/*.md"],
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "./x.sh fmt": "allow",
      "./x.sh fmt-check": "allow",
      "./x.sh nix-build-home": "allow",
      "./x.sh nix-build-home-locked": "allow",
      "./x.sh nix-build-system": "allow",
      "./x.sh nix-diff-home": "allow",
      "./x.sh nix-diff-system": "allow",
      "./x.sh nix-eval-home": "allow",
      "./x.sh nix-eval-home-locked": "allow",
      "./x.sh nix-eval-system": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "bash -n *": "allow",
      "bash *": "allow",
      "cat *": "allow",
      "chmod *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "expr *": "allow",
      "false": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh issue list *": "allow",
      "gh issue status *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow",
      "gh repo view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "gh search *": "allow",
      "gh status *": "allow",
      "gh workflow list *": "allow",
      "gh workflow view *": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "git revert *": "ask",
      "git cherry-pick *": "ask",
      "git rm *": "ask",
      "go *": "allow",
      "grep *": "allow",
      "groups *": "allow",
      "head *": "allow",
      "id *": "allow",
      "jj *": "allow",
      "jj git push *": "ask",
      "jj": "allow",
      "git-branch-current *": "allow",
      "git-branch-default *": "allow",
      "git-branch-next *": "allow",
      "git-branch-previous *": "allow",
      "git-branch-stacked *": "allow",
      "jj-bookmark-current *": "allow",
      "jj-bookmark-default *": "allow",
      "jj-bookmark-previous *": "allow",
      "jj-bookmark-stacked *": "allow",
      "jq *": "allow",
      "less *": "allow",
      "ln *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "mkdir *": "allow",
      "more *": "allow",
      "mv *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "python3 *": "allow",
      "read *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "seq *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "true": "allow",
      "type *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs ls *": "allow",
      "zsh *": "allow"
    },
    "external_directory": {
      "~/.agents/**": "allow",
      "~/.claude/skills/**": "allow",
      "~/.claude/rules/**": "allow"
    }
  }
}
