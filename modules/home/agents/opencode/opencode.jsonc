{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "update": "disable",
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
