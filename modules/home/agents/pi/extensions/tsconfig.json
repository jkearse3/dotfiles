{
  // `.pi-types` links to the pi-extension-types package, which supplies the
  // `paths` for the modules pi provides. Do not set `paths` or `baseUrl` here:
  // either replaces the inherited mappings.
  "extends": "./.pi-types/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "typeRoots": ["./node_modules/@types", "./.pi-types/node_modules/@types"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
