{
  // `.pi-types` links to the pi-extension-types package, which supplies the
  // `paths` for the modules pi provides. Do not set `paths` or `baseUrl` here:
  // either replaces the inherited mappings.
  "extends": "./.pi-types/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Only Node's ambient types come from pi's tree. Naming that whole `@types`
    // directory as a type root would also make every package in it importable
    // here, though pi resolves none of them for an extension.
    "types": ["./.pi-types/node_modules/@types/node"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
