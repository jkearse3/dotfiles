# Keep destructive Git operations behind an explicit approval when Codex asks
# to run them outside its sandbox. Codex validates the examples on load.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "A hard reset can discard uncommitted work; confirm the exact target first.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "prompt",
    justification = "Checking out paths can discard uncommitted work; confirm the exact paths first.",
    match = [
        "git checkout -- README.md",
        "git checkout -- src tests",
    ],
    not_match = [
        "git checkout feature-branch",
    ],
)
