{
  "settings": {
    "showStatusIcon": false
  },
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      },
      "lifecycle": "lazy",
      "requestTimeoutMs": 60000,
      "includeTools": ["web_search_exa"],
      "directTools": ["web_search_exa"]
    }
  }
}
