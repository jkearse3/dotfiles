{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(jj git push --help)",
      "Bash(jj git push --bookmark *)",
      "Bash(jj git push --remote * --bookmark *)"
    ],
    "deny": ["AskUserQuestion", "EnterPlanMode", "Agent(Plan)"],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rm:*)",
      "Bash(jj git push * main*)",
      "Bash(jj git push * master*)",
      "Bash(jj git push *--config*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "disableAgentView": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "idleCompaction": false,
  "theme": "dark-ansi",
  "outputStyle": "Concise",
  "editorMode": "vim",
  "verbose": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
