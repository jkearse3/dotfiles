{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./x.sh fmt)",
      "Bash(./x.sh fmt-check)",
      "Bash(./x.sh nix-build-home)",
      "Bash(./x.sh nix-build-home-locked)",
      "Bash(./x.sh nix-build-system)",
      "Bash(./x.sh nix-diff-home)",
      "Bash(./x.sh nix-diff-system)",
      "Bash(./x.sh nix-eval-home)",
      "Bash(./x.sh nix-eval-home-locked)",
      "Bash(./x.sh nix-eval-system)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(commit-message format)",
      "Bash(commit-message format:*)",
      "Bash(commit-message validate)",
      "Bash(commit-message validate:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(expr:*)",
      "Bash(false)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh search:*)",
      "Bash(gh status:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(gofumpt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(grep:*)",
      "Bash(groups:*)",
      "Bash(head:*)",
      "Bash(id:*)",
      "Bash(jj:*)",
      "Bash(git-branch-current:*)",
      "Bash(git-branch-default:*)",
      "Bash(git-branch-next:*)",
      "Bash(git-branch-previous:*)",
      "Bash(git-branch-stacked:*)",
      "Bash(jj-bookmark-current:*)",
      "Bash(jj-bookmark-default:*)",
      "Bash(jj-bookmark-previous:*)",
      "Bash(jj-bookmark-stacked:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(mkdir:*)",
      "Bash(more:*)",
      "Bash(mv:*)",
      "Bash(playwright-cli:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(python3:*)",
      "Bash(read:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(seq:*)",
      "Bash(sleep:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(true)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(xargs ls:*)",
      "Bash(zsh:*)",
      "Read(//nix/store/**)",
      "Read(.objectives/**)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/rules/**)",
      "Read(~/.agents/**)",
      "Read(~/dotfiles/modules/home/agents/**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "mcp__ide__getDiagnostics"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rm:*)",
      "Bash(jj git push:*)"
    ],
    "deny": ["AskUserQuestion"],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      ".objectives",
      "~/.claude/skills",
      "~/.claude/rules",
      "~/.agents"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
