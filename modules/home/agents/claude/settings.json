{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./x.sh nix-eval:*)",
      "Bash(./x.sh nix-update:*)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(bash -n:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(expr:*)",
      "Bash(false)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh search issues:*)",
      "Bash(gh search prs:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git show:*)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofumpt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(grep:*)",
      "Bash(groups:*)",
      "Bash(head:*)",
      "Bash(id:*)",
      "Bash(jj --version)",
      "Bash(jj bookmark create:*)",
      "Bash(jj commit:*)",
      "Bash(jj describe:*)",
      "Bash(jj diff:*)",
      "Bash(jj git fetch)",
      "Bash(jj help:*)",
      "Bash(jj log:*)",
      "Bash(jj new:*)",
      "Bash(jj show:*)",
      "Bash(jj split:*)",
      "Bash(jj st:*)",
      "Bash(jj status:*)",
      "Bash(jj)",
      "Bash(git-branch-current:*)",
      "Bash(git-branch-default:*)",
      "Bash(git-branch-next:*)",
      "Bash(git-branch-previous:*)",
      "Bash(git-branch-stacked:*)",
      "Bash(jj-bookmark-current:*)",
      "Bash(jj-bookmark-default:*)",
      "Bash(jj-bookmark-previous:*)",
      "Bash(jj-bookmark-stacked:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(mkdir:*)",
      "Bash(more:*)",
      "Bash(mv:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(read:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(seq:*)",
      "Bash(sleep:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(true)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami)",
      "Bash(xargs ls:*)",
      "Bash(zsh:*)",
      "Read(.objectives/**)",
      "Read(//nix/store/**)",
      "Read(~/.claude/**)",
      "Skill(code-review)",
      "Skill(diff-summarize)",
      "Skill(jj-atomize)",
      "Skill(investigate)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:direnv.net)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:flake.parts)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:jj-vcs.github.io)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:starship.rs)",
      "WebFetch(domain:www.anthropic.com)",
      "WebSearch",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/detect-vcs.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(basename \"$PWD\") at $(date '+%H:%M')\\\" with title \\\"Claude stopped\\\"\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"Waiting for permission/input in $(basename \"$PWD\") at $(date '+%H:%M')\\\" with title \\\"Claude needs attention\\\" sound name \\\"default\\\"\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
