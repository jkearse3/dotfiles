{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/schemas/pyrightconfig.schema.json",
  "include": [
    "modules/home/agents/skills/**/scripts",
    "packages/commit-message",
    "packages/direnv-worktree",
    "packages/nix-cleanup",
    "packages/nvim-pack",
    "packages/jjx",
    "packages/pi-shepherd",
    "packages/token-count"
  ],
  "executionEnvironments": [
    {
      "root": "packages/pi-shepherd/tests",
      "extraPaths": ["packages/pi-shepherd/src", "packages/pi-shepherd/tests"]
    },
    {
      "root": "packages/pi-shepherd/src"
    },
    {
      "root": "packages/commit-message",
      "extraPaths": ["packages/commit-message/src"]
    },
    {
      "root": "packages/jjx",
      "extraPaths": ["packages/jjx/src"]
    }
  ]
}
