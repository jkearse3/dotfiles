{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(nix fmt)",
      "Bash(nix build --no-link .#lint)",
      "Bash(nix build .#lint)",
      "Bash(nix build --no-link .#eval-blueprints)",
      "Bash(nix build .#eval-blueprints)",
      "Bash(nix build --no-link .#checks.aarch64-darwin.treefmt)",
      "Bash(nix build .#checks.aarch64-darwin.treefmt)",
      "Bash(nix flake check)",
      "Bash(nix eval .#blueprints --apply builtins.attrNames)",
      "Bash(nix run .#build-home)",
      "Bash(nix run .#build-system)"
    ]
  }
}
